{
  "projectId": "",
  "projectName": "carChecking",
  "sites": [
    {
      "$id": "carchecking",
      "name": "carChecking Website",
      "framework": "vite",
      "adapter": "static",
      "buildRuntime": "node-22",
      "installCommand": "npm install",
      "buildCommand": "node scripts/deploy-functions.mjs && FUNC_DOMAIN=https://$(echo $APPWRITE_SITE_NAME | tr 'A-Z' 'a-z').functions.$(echo $APPWRITE_SITE_API_ENDPOINT | sed 's|https://server\\.||;s|/v1||') && VITE_APPWRITE_PROJECT_ID=$APPWRITE_SITE_PROJECT_ID VITE_APPWRITE_BASE=$APPWRITE_SITE_API_ENDPOINT VITE_MULTA_API_URL=$FUNC_DOMAIN VITE_FUNCTIONS_BASE=$FUNC_DOMAIN npm run build",
      "buildOutput": "dist",
      "enabled": true,
      "logging": false,
      "timeout": 30
    }
  ],
  "functions": [
    {
      "$id": "multas",
      "name": "Multas",
      "runtime": "node-16.0",
      "path": "appwrite/functions/multas",
      "entrypoint": "src/index.js",
      "ignore": ["node_modules", ".git"],
      "execute": ["any"],
      "events": [],
      "schedule": "",
      "timeout": 300,
      "enabled": true,
      "logging": true
    },
    {
      "$id": "mp-create-preference",
      "name": "MP Create Preference",
      "runtime": "node-16.0",
      "path": "appwrite/functions/mp-create-preference",
      "entrypoint": "src/index.js",
      "ignore": ["node_modules", ".git"],
      "execute": ["any"],
      "events": [],
      "schedule": "",
      "timeout": 15,
      "enabled": true,
      "logging": true
    },
    {
      "$id": "mp-verify-preference",
      "name": "MP Verify Preference",
      "runtime": "node-16.0",
      "path": "appwrite/functions/mp-verify-preference",
      "entrypoint": "src/index.js",
      "ignore": ["node_modules", ".git"],
      "execute": ["any"],
      "events": [],
      "schedule": "",
      "timeout": 15,
      "enabled": true,
      "logging": true
    }
  ]
}
